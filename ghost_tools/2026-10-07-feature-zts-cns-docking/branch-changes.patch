+        elif outcome in ("passed", "failed"):
+            mutant.outcome = "killed"
+        else:
+            mutant.outcome = "error"
+    else:
+        mutant.outcome = "survived" if outcome == "passed" else ("killed" if outcome == "failed" else "error")
+    return mutant.outcome == "survived"
